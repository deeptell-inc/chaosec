\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Thermal codes protect information better than scar codes.} Reference-qubit coherent information $\mathcal  {C}_R$ versus measurement rate $p$ for the scar code (red) and the thermal ensemble (blue; band is $\pm 1\sigma $ over the ensemble) under (a) local-$Z$ and (b) collective staggered-$Z$ monitoring at $L=14$. The scar lies below the thermal band throughout.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:crossover}{{1}{3}{\textbf {Thermal codes protect information better than scar codes.} Reference-qubit coherent information $\CR $ versus measurement rate $p$ for the scar code (red) and the thermal ensemble (blue; band is $\pm 1\sigma $ over the ensemble) under (a) local-$Z$ and (b) collective staggered-$Z$ monitoring at $L=14$. The scar lies below the thermal band throughout}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {c}Mechanism: both channels resolve the scar code.}{3}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The scar disadvantage $\Delta \mathcal  {C}_R<0$ at every size.} Scar-minus- thermal coherent information at $p=0.10$ versus $L$ for local (grey) and collective (green) monitoring; shading is the thermal-ensemble spread.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:scaling}{{2}{3}{\textbf {The scar disadvantage $\Delta \CR <0$ at every size.} Scar-minus- thermal coherent information at $p=0.10$ versus $L$ for local (grey) and collective (green) monitoring; shading is the thermal-ensemble spread}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The maximal scar code loses even as an extensive memory.} Protected-information density $S_R/k$ for the maximal $k=\lfloor \log _2(L{+}1) \rfloor $-qubit scar code (solid) and a same-dimension thermal code (dashed, $\pm 1\sigma $ band) versus $p$ under local monitoring, for $L=10,14,18$. Scar lies below thermal throughout.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:ext}{{3}{3}{\textbf {The maximal scar code loses even as an extensive memory.} Protected-information density $S_R/k$ for the maximal $k=\lfloor \log _2(L{+}1) \rfloor $-qubit scar code (solid) and a same-dimension thermal code (dashed, $\pm 1\sigma $ band) versus $p$ under local monitoring, for $L=10,14,18$. Scar lies below thermal throughout}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {d}The decoherence-free-subspace rescue fails.}{3}{section*.10}\protected@file@percent }
\citation{Schecter2019}
\citation{Paviglianiti2025}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {What controls collective protection.} Collective $\mathcal  {C}_R$ versus (a) $Z$-basis participation and (b) logical leak $|\langle 0|O|1\rangle |$ over an eigenstate sweep (blue), product states (orange), and the canonical scar (star). Higher participation raises $\mathcal  {C}_R$; large leak suppresses it. The scar is a low-$\mathcal  {C}_R$ outlier on both axes.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:mech}{{4}{4}{\textbf {What controls collective protection.} Collective $\CR $ versus (a) $Z$-basis participation and (b) logical leak $|\langle 0|O|1\rangle |$ over an eigenstate sweep (blue), product states (orange), and the canonical scar (star). Higher participation raises $\CR $; large leak suppresses it. The scar is a low-$\CR $ outlier on both axes}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {e}A second model isolates the variance as the culprit.}{4}{section*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Exact-su(2) scars evade the Casimir-variance obstruction.} Second model (spin-1 Schecter--Iadecola, $L=6$, $20$-pair thermal ensemble). (a) Scar$-$thermal coherent information $\Delta \mathcal  {C}_R$ versus $p$ (error bars are the ensemble SEM). Under $J^2$ monitoring PXP scars lose (blue) while exact spin-1 scars win perfectly (red); under generic local $S^z$ the exact-scar and thermal codes are comparable ($|\Delta \mathcal  {C}_R|\lesssim 0.1$, grey). (b) Scar Casimir variance, $\simeq 32$ (PXP) versus $\sim 10^{-13}$ (exact) on a log scale---the control parameter of the rescue.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:spin1}{{5}{4}{\textbf {Exact-su(2) scars evade the Casimir-variance obstruction.} Second model (spin-1 Schecter--Iadecola, $L=6$, $20$-pair thermal ensemble). (a) Scar$-$thermal coherent information $\Delta \CR $ versus $p$ (error bars are the ensemble SEM). Under $J^2$ monitoring PXP scars lose (blue) while exact spin-1 scars win perfectly (red); under generic local $S^z$ the exact-scar and thermal codes are comparable ($|\Delta \CR |\lesssim 0.1$, grey). (b) Scar Casimir variance, $\simeq 32$ (PXP) versus $\sim 10^{-13}$ (exact) on a log scale---the control parameter of the rescue}{figure.5}{}}
